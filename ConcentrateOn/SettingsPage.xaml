<Page
    x:Class="ConcentrateOn.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConcentrateOn"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="10 0 0 0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        </Style>
        <Style TargetType="ToggleSwitch">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10 0 0 0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

               
        <ScrollViewer Grid.Column="1"  Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <controls:WrapPanel Orientation="Horizontal" Margin="5">
                    <TextBlock x:Name="lbl_WorkTimePeriodMinutes" x:Uid="lbl_WorkTimePeriodMinutes"/>
                    <ComboBox x:Name="cmbx_WorkTimePeriodMinutes" ItemsSource="{x:Bind IntValues}" 
                              DisplayMemberPath="StrVal"
                              SelectionChanged="cmbx_SelectionChanged">
                    </ComboBox>
                </controls:WrapPanel>

                <controls:WrapPanel Orientation="Horizontal" Margin="5">
                    <TextBlock x:Name="lbl_ShortRestMinutes" x:Uid="lbl_ShortRestMinutes" />
                    <ComboBox x:Name="cmbx_ShortRestMinutes" ItemsSource="{x:Bind IntValues}"  
                              DisplayMemberPath="StrVal"
                              SelectionChanged="cmbx_SelectionChanged">
                    </ComboBox>
                </controls:WrapPanel>

                <controls:WrapPanel Orientation="Horizontal" Margin="5">
                    <TextBlock x:Name="lbl_LongRestMinutes" x:Uid="lbl_LongRestMinutes"/>
                    <ComboBox x:Name="cmbx_LongRestMinutes" ItemsSource="{x:Bind IntValues}"  
                              DisplayMemberPath="StrVal"
                              SelectionChanged="cmbx_SelectionChanged">
                    </ComboBox>
                </controls:WrapPanel>

                <controls:WrapPanel Orientation="Horizontal" Margin="5">
                    <TextBlock x:Name="lbl_IntervalForLongRest" x:Uid="lbl_IntervalForLongRest" />
                    <ComboBox x:Name="cmbx_IntervalForLongRest"  ItemsSource="{x:Bind IntValues}"  
                              DisplayMemberPath="StrVal"
                              SelectionChanged="cmbx_SelectionChanged">
                    </ComboBox>
                </controls:WrapPanel>

                <controls:WrapPanel Orientation="Horizontal" Margin="5">
                    <TextBlock x:Name="lbl_SendNotifications" x:Uid="lbl_SendNotifications" />
                    <ToggleSwitch x:Name="toggle_send_notificaions" x:Uid="toggle_send_notificaions"
                                  Toggled="toggle_send_notificaions_Toggled"/>
                    <TextBlock x:Name="lbl_NotificationsWithSound" x:Uid="lbl_NotificationsWithSound" Margin="10 0 0 0"/>
                    <ToggleSwitch x:Name="toggle_NotificationsWithSound" x:Uid="toggle_NotificationsWithSound"
                                  Toggled="toggle_NotificationsWithSound_Toggled" 
                                  IsEnabled="{Binding ElementName=toggle_send_notificaions, Path=IsOn}"/>
                </controls:WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    
</Page>
